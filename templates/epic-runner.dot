digraph EpicRunner {
    label="Process all tasks in an epic"
    goal="Implement all child tasks of epic EPIC_ID, closing each as completed."
    model="sonnet"

    start [shape="Mdiamond"]
    done  [shape="Msquare"]

    // --- Pick the next task ---
    // PAS claims the next ready child Task through Beads, writes
    // .pas/current_task.md, and routes MORE / DONE / BLOCKED.
    pick_task [
        shape="diamond"
        type="beads.select"
        label="Pick Next Task"
        epic="EPIC_ID"
    ]

    // Open Tasks remain but none are ready. pick_task already recorded
    // TaskSelectionBlocked, so the Run ends without another Model Invocation.
    blocked [
        shape="diamond"
        label="Blocked: open Tasks remain but none are ready"
    ]

    // --- Investigate ---
    investigate [
        shape="box"
        label="Investigate"
        llm_provider="claude"
        timeout="900s"
        allowed_tools="Read,Grep,Glob"
        prompt="Read .pas/current_task.md for the current task ID, description, and acceptance criteria.

Investigate the codebase to understand what needs to change:
- Find the relevant files and functions
- Understand the current behavior
- Identify what needs to change

Write your findings to .pas/investigation.md including:
- Files to modify
- Current behavior
- Required changes
- Any risks or dependencies"
    ]

    // --- Implement ---
    implement [
        shape="box"
        label="Implement"
        llm_provider="claude"
        timeout="900s"
        prompt="Read .pas/current_task.md for the task and .pas/investigation.md for the plan.
Implement the changes described. Follow existing code patterns and conventions.
Keep changes minimal and focused on the task requirements."
    ]

    // --- Test ---
    run_tests [
        shape="box"
        label="Run Tests"
        llm_provider="claude"
        timeout="900s"
        prompt="Read .pas/current_task.md to understand what was changed.
Run the relevant test suite for the modified code.
If tests fail, fix the issues and re-run until green.
Write the test results to .pas/test-results.md"
    ]

    // --- Verify ---
    verify [
        shape="diamond"
        label="Verify"
        node_type="conditional"
        llm_provider="claude"
        timeout="300s"
        prompt="Read .pas/current_task.md for the task requirements.
Check the changes:
1. Review the git diff
2. Run the linter on changed files
3. Verify tests pass (read .pas/test-results.md)
4. Check that the task's acceptance criteria are met

If everything looks good, respond with PASS on the last line.
If there are problems, respond with FAIL on the last line."
    ]

    fixup [
        shape="box"
        label="Fix Issues"
        llm_provider="claude"
        timeout="900s"
        prompt="Read .pas/current_task.md and .pas/investigation.md for context.
The verification step found problems. Fix any failing tests, lint errors, or unmet acceptance criteria.
Re-run tests after fixing."
    ]

    // --- Publish this task's commits (the engine only observes them) ---
    publish [
        shape="box"
        label="Commit and Push"
        llm_provider="claude"
        timeout="300s"
        allowed_tools="Bash(git:*)"
        prompt="Read .pas/current_task.md to get the task ID.
1. Stage only the files this task changed (never git add -A)
2. Commit with a descriptive message referencing the task ID
3. Run: git pull --rebase
4. Run: git push
5. Confirm HEAD is on its upstream branch (git status shows up to date)"
    ]

    // --- Close this task ---
    // PAS closes the Task only after its Run Commits are on the upstream branch.
    close_task [
        shape="box"
        type="beads.close"
        label="Close Task"
        require_upstream=true
    ]

    // --- Edges ---
    start -> pick_task

    pick_task -> investigate [label="MORE", condition="preferred_label=MORE"]
    pick_task -> done        [label="DONE", condition="preferred_label=DONE"]
    pick_task -> blocked     [label="BLOCKED", condition="preferred_label=BLOCKED"]
    blocked   -> done

    investigate -> implement -> run_tests -> verify

    verify -> publish [label="PASS", condition="preferred_label=PASS"]
    verify -> fixup   [label="FAIL", condition="preferred_label=FAIL"]
    fixup  -> verify

    publish -> close_task

    close_task -> pick_task [label="CLOSED", condition="outcome=success", loop_restart=true, reset_quality_loop_state=true]
    close_task -> publish   [label="UNPUBLISHED", condition="outcome=fail"]
}

 fn get_bool_attr(attrs: &HashMap<String, AttributeValue>, key: &str) -> Option<bool> {
     attrs.get(key).and_then(|v| match v {
         AttributeValue::Boolean(b) => Some(*b),
         AttributeValue::String(s) => Some(s == "true"),
         _ => None,
     })
